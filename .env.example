# Local single-key mode only. Generate a different secret with a password manager.
# For a hosted multi-caller deployment, configure TAV_API_KEYS in the secret manager instead.
TAV_API_KEY=replace-with-a-unique-random-secret-at-least-32-characters
TAV_HOST=127.0.0.1
TAV_PORT=8080
# TAV_API_KEYS={"client-id":"64-character-sha256-hex-digest"}
